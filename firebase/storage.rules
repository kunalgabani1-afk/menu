rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /restaurants/{restaurantId}/{assetPath=**} {
      allow read: if resource.metadata.public == 'true' ||
        (request.auth != null &&
          request.auth.token.restaurantIds[restaurantId] == true);
      allow write: if request.auth != null &&
        request.auth.token.restaurantRoles[restaurantId] in ['owner', 'manager'] &&
        request.resource.size < 5 * 1024 * 1024 &&
        request.resource.contentType.matches('image/(png|jpeg|webp)');
    }
  }
}