# ==============================================================================
# Client-Side Configuration (Browser-Safe Public Identifiers)
# Prefixed with VITE_ to be exposed to Vite frontend builds.
# Never place service account private keys or server credentials here.
# ==============================================================================
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_DATABASE_URL=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# ==============================================================================
# Server-Side Configuration (Admin Secrets & Service Account)
# Kept strictly server-side. Never expose with VITE_ prefix.
# You can provide either FIREBASE_SERVICE_ACCOUNT_JSON as a single JSON string,
# OR provide the individual variables below.
# ==============================================================================
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=
FIREBASE_DATABASE_URL=
FIREBASE_STORAGE_BUCKET=

# ==============================================================================
# Authentication & Transactional Email
# All authentication, password resets, verification emails, and magic links
# are handled directly and securely through Firebase Authentication.
# No third-party SMTP or email API services required.
# ==============================================================================

# ==============================================================================
# EmailJS — Public Contact Form Verification Email Delivery
# Used exclusively for sending public contact form verification links.
# Kept strictly server-side. Never expose private credentials to client.
# ==============================================================================
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key
CONTACT_EMAIL_VERIFICATION_EXPIRY_MINUTES=30
APP_URL=https://tableline.in


